<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.r31.paperbot" android:versionCode="44" android:versionName="0.44-paper">
<uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
<uses-permission android:name="android.permission.INTERNET"/>
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<uses-permission android:name="android.permission.WAKE_LOCK"/>
<application android:label="R31 Paperbot" android:allowBackup="false" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@android:drawable/ic_menu_manage">
<activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden">
<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
</activity>
<provider android:name=".UpdateProvider" android:authorities="com.r31.paperbot.update" android:exported="false" android:grantUriPermissions="true"/>
<service android:name=".PaperSyncService" android:exported="false" android:foregroundServiceType="dataSync" android:stopWithTask="false"/>
</application></manifest>